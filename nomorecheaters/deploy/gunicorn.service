# ── No More Cheaters — Gunicorn systemd unit (C3 / finalplan Task 3.5) ───────
#
# Serves the Django WSGI app on 127.0.0.1:8000, which the Nginx block in
# nginx.conf proxies to. Auto-restarts on crash and on reboot.
#
# Install:
#   sudo cp deploy/gunicorn.service /etc/systemd/system/nomorecheaters.service
#   # edit the ALL-CAPS placeholders below first
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now nomorecheaters
#
# NOTE: the AI analysis pipeline runs NATIVELY in-process here — with RQ_ASYNC
# off (the default) an upload runs run_analysis() synchronously inside the
# request, so no Redis and no separate worker process are needed. The trade-off
# is that the upload request blocks until analysis finishes, which is why the
# --timeout below is large; keep it comfortably above your longest expected
# analysis time or long videos will be killed mid-process (worker timeout).

[Unit]
Description=No More Cheaters Gunicorn daemon
After=network.target

[Service]
User=YOUR_DEPLOY_USER
Group=www-data
WorkingDirectory=/PATH/TO/no-more-cheaters-backend/nomorecheaters

# Optional env file. Settings are hardcoded in settings.py (DB, ALLOWED_HOSTS,
# CORS/CSRF, FRONTEND_URL all baked in), so this file may not exist — the
# leading '-' tells systemd to start anyway if it's missing.
EnvironmentFile=-/PATH/TO/no-more-cheaters-backend/nomorecheaters/.env

# --timeout is large because analysis runs in-request (see NOTE above). Each
# sync worker can process one analysis at a time, so --workers also caps how
# many uploads can be analysed concurrently — raise it (and your instance size)
# if you need more parallelism.
ExecStart=/PATH/TO/venv/bin/gunicorn \
    --workers 3 \
    --bind 127.0.0.1:8000 \
    --timeout 1800 \
    nomorecheaters.wsgi:application

Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
