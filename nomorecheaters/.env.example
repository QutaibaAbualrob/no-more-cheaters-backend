# Copy to `.env` (same directory as manage.py) and fill in real values.
# Loaded automatically by settings.py when python-dotenv is installed.
# Do NOT commit the real .env file.

# --- Core ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# true only for local development; leave false/unset in production (EC2)
DJANGO_DEBUG=true
# comma-separated; required when DEBUG is false (e.g. api.nomorecheater.online,1.2.3.4)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database ---
# Defaults to MySQL (the production database). Locally you only need to create
# the DB + user and set DB_PASSWORD:
#   CREATE DATABASE nomorecheaters CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'nomorecheaters'@'localhost' IDENTIFIED BY 'your-password';
#   GRANT ALL PRIVILEGES ON nomorecheaters.* TO 'nomorecheaters'@'localhost';
DB_ENGINE=django.db.backends.mysql
DB_NAME=nomorecheaters
DB_USER=nomorecheaters
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306
#
# To skip MySQL entirely for local dev / running tests, use SQLite instead:
# DB_ENGINE=django.db.backends.sqlite3
# DB_NAME=db.sqlite3

# --- CORS / CSRF (comma-separated origins, scheme required) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Origins trusted for unsafe cross-origin requests; in prod list your real URLs.
CSRF_TRUSTED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Base URL of the React SPA (used to build email-verification links).
FRONTEND_URL=http://localhost:5173

# --- AI analysis execution ---
# Leave RQ_ASYNC off: analysis runs natively in-process (inside the Gunicorn
# worker / dev server), so no Redis or separate worker is required. The upload
# request blocks until analysis finishes — keep the Gunicorn --timeout high.
RQ_ASYNC=false

# --- Email (Resend SMTP). Falls back to console output when unset. ---
# EMAIL_HOST_PASSWORD=
# DEFAULT_FROM_EMAIL=noreply@nomorecheater.online

# --- HTTPS hardening (only read when DJANGO_DEBUG=false) ---
# Set to false if you terminate TLS elsewhere or run on bare HTTP/IP for now.
# SECURE_SSL_REDIRECT=true
# Raise to 31536000 (1 year) once HTTPS is confirmed stable.
# SECURE_HSTS_SECONDS=0
