# Copy to `.env` (same directory as manage.py) and fill in real values.
# Loaded automatically by settings.py when python-dotenv is installed.
# Do NOT commit the real .env file.

# --- Core ---
# Generate one with: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
DJANGO_SECRET_KEY=
# true only for local development; leave false/unset in production
DJANGO_DEBUG=true
# comma-separated; required when DEBUG is false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- Database (defaults to local SQLite when unset) ---
# For Postgres:
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=nomorecheaters
# DB_USER=nomorecheaters
# DB_PASSWORD=
# DB_HOST=127.0.0.1
# DB_PORT=5432

# --- CORS (comma-separated origins) ---
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
